@{
    ViewData["Title"] = "Administración";
}

<section class="admin-login-page">

    <div class="admin-login-shell">

        <!-- =========================
             PANEL DE MARCA
        ========================== -->
        <div class="admin-login-brand">

            <div class="admin-login-brand-content">

                <span class="admin-login-logo">
                    VYR ✦
                </span>

                <div class="admin-login-line"></div>

                <p class="admin-login-kicker">
                    COLECCIÓN NAVAL
                </p>

                <h2>
                    Administración
                    <br />
                    VyR
                </h2>

                <p class="admin-login-description">
                    Gestioná productos, pedidos y
                    colecciones desde un solo lugar.
                </p>

            </div>

            <span class="admin-login-decoration">
                ✦
            </span>

        </div>


        <!-- =========================
             FORMULARIO
        ========================== -->
        <div class="admin-login-form-panel">

            <div class="admin-login-form-content">

                <p class="admin-login-eyebrow">
                    ADMINISTRACIÓN
                </p>

                <h1>
                    Bienvenida
                </h1>

                <p class="admin-login-subtitle">
                    Ingresá tus datos para acceder
                    al panel de control.
                </p>


                <!-- ERROR -->
                @if (ViewBag.Error != null)
                {
                    <div class="admin-login-error">
                        <span>!</span>

                        <p>
                            @ViewBag.Error
                        </p>
                    </div>
                }


                <!-- FORMULARIO -->
                <form method="post"
                      class="admin-login-form">

                    <!-- USUARIO -->
                    <div class="admin-login-field">

                        <label for="usuario">
                            Usuario
                        </label>

                        <input id="usuario"
                               name="usuario"
                               type="text"
                               placeholder="Ingresá tu usuario"
                               autocomplete="username"
                               required />

                    </div>


                    <!-- CONTRASEÑA -->
                    <div class="admin-login-field">

                        <label for="password">
                            Contraseña
                        </label>

                        <div class="admin-password-wrapper">

                            <input id="password"
                                   name="password"
                                   type="password"
                                   placeholder="Ingresá tu contraseña"
                                   autocomplete="current-password"
                                   required />

                            <button type="button"
                                    class="admin-password-toggle"
                                    onclick="toggleAdminPassword()"
                                    aria-label="Mostrar contraseña">

                                <span id="passwordIcon">
                                    VER
                                </span>

                            </button>

                        </div>

                    </div>


                    <!-- BOTÓN -->
                    <button type="submit"
                            class="admin-login-submit">

                        INGRESAR AL PANEL

                        <span>
                            →
                        </span>

                    </button>

                </form>


                <!-- VOLVER -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="admin-login-back">

                    ← Volver a la tienda

                </a>

            </div>

        </div>

    </div>

</section>


<style>

    /* =========================================================
       LOGIN ADMINISTRACIÓN - VYR NAVY POP
       ========================================================= */

    .admin-login-page {
        --admin-navy: #081f33;
        --admin-navy-soft: #102d44;
        --admin-cream: #f6efe3;
        --admin-cream-light: #fffaf2;
        --admin-gold: #d2a62c;
        --admin-sky: #b8d4df;
        --admin-muted: #6f777b;

        min-height: calc(100vh - 120px);
        padding: 48px 24px;

        display: flex;
        align-items: center;
        justify-content: center;

        background:
            radial-gradient(
                circle at 10% 10%,
                rgba(184, 212, 223, 0.20),
                transparent 30%
            ),
            var(--admin-cream);
    }


    /* =========================================================
       CONTENEDOR
       ========================================================= */

    .admin-login-shell {
        width: min(1050px, 100%);
        min-height: 610px;

        display: grid;
        grid-template-columns: 0.92fr 1.08fr;

        background: var(--admin-cream-light);

        border: 1px solid rgba(8, 31, 51, 0.12);
        border-radius: 30px;

        overflow: hidden;

        box-shadow:
            0 28px 80px rgba(8, 31, 51, 0.12);
    }


    /* =========================================================
       PANEL IZQUIERDO
       ========================================================= */

    .admin-login-brand {
        position: relative;

        padding: 64px;

        display: flex;
        align-items: center;

        overflow: hidden;

        background: var(--admin-navy);
        color: white;
    }


    .admin-login-brand::before {
        content: "";

        position: absolute;

        width: 330px;
        height: 330px;

        left: -160px;
        bottom: -170px;

        border-radius: 50%;

        border:
            1px solid rgba(210, 166, 44, 0.28);
    }


    .admin-login-brand::after {
        content: "";

        position: absolute;

        width: 210px;
        height: 210px;

        right: -105px;
        top: -105px;

        border-radius: 50%;

        background:
            rgba(184, 212, 223, 0.08);
    }


    .admin-login-brand-content {
        position: relative;
        z-index: 2;

        max-width: 360px;
    }


    .admin-login-logo {
        display: inline-block;

        margin-bottom: 32px;

        font-size: 14px;
        font-weight: 800;

        letter-spacing: 0.22em;

        color: var(--admin-gold);
    }


    .admin-login-line {
        width: 45px;
        height: 2px;

        margin-bottom: 28px;

        background: var(--admin-gold);
    }


    .admin-login-kicker {
        margin: 0 0 15px;

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.22em;

        color: var(--admin-sky);
    }


    .admin-login-brand h2 {
        margin: 0;

        font-size: clamp(42px, 5vw, 68px);
        font-weight: 500;

        line-height: 0.98;
        letter-spacing: -0.045em;
    }


    .admin-login-description {
        max-width: 300px;

        margin: 28px 0 0;

        font-size: 14px;
        line-height: 1.7;

        color: rgba(255, 255, 255, 0.65);
    }


    .admin-login-decoration {
        position: absolute;

        right: 38px;
        bottom: 30px;

        font-size: 24px;

        color: var(--admin-gold);
    }


    /* =========================================================
       PANEL FORMULARIO
       ========================================================= */

    .admin-login-form-panel {
        padding: 65px 75px;

        display: flex;
        align-items: center;

        background: var(--admin-cream-light);
    }


    .admin-login-form-content {
        width: 100%;
        max-width: 430px;

        margin: auto;
    }


    .admin-login-eyebrow {
        margin: 0 0 15px;

        font-size: 11px;
        font-weight: 800;

        letter-spacing: 0.20em;

        color: var(--admin-gold);
    }


    .admin-login-form-content h1 {
        margin: 0;

        font-size: clamp(38px, 4vw, 54px);
        font-weight: 500;

        line-height: 1;

        letter-spacing: -0.04em;

        color: var(--admin-navy);
    }


    .admin-login-subtitle {
        margin: 18px 0 36px;

        max-width: 350px;

        font-size: 14px;
        line-height: 1.65;

        color: var(--admin-muted);
    }


    /* =========================================================
       ERROR
       ========================================================= */

    .admin-login-error {
        display: flex;
        align-items: center;
        gap: 12px;

        margin-bottom: 24px;
        padding: 13px 15px;

        border: 1px solid rgba(164, 57, 57, 0.18);
        border-radius: 12px;

        background: rgba(164, 57, 57, 0.07);

        color: #8d3030;
    }


    .admin-login-error span {
        width: 22px;
        height: 22px;

        flex: 0 0 22px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #8d3030;

        color: white;

        font-size: 11px;
        font-weight: 800;
    }


    .admin-login-error p {
        margin: 0;

        font-size: 12px;
        line-height: 1.45;
    }


    /* =========================================================
       FORM
       ========================================================= */

    .admin-login-form {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }


    .admin-login-field {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }


    .admin-login-field label {
        font-size: 10px;
        font-weight: 800;

        letter-spacing: 0.15em;
        text-transform: uppercase;

        color: var(--admin-navy);
    }


    .admin-login-field input {
        width: 100%;
        height: 54px;

        padding: 0 16px;

        box-sizing: border-box;

        border:
            1px solid rgba(8, 31, 51, 0.18);

        border-radius: 12px;

        outline: none;

        background: white;

        color: var(--admin-navy);

        font-family: inherit;
        font-size: 14px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }


    .admin-login-field input::placeholder {
        color: #a1a4a5;
    }


    .admin-login-field input:focus {
        border-color: var(--admin-gold);

        box-shadow:
            0 0 0 3px rgba(210, 166, 44, 0.10);

        background: #fff;
    }


    /* =========================================================
       CONTRASEÑA
       ========================================================= */

    .admin-password-wrapper {
        position: relative;
    }


    .admin-password-wrapper input {
        padding-right: 65px;
    }


    .admin-password-toggle {
        position: absolute;

        top: 50%;
        right: 16px;

        transform: translateY(-50%);

        padding: 5px;

        border: 0;
        background: transparent;

        color: var(--admin-navy);

        font-family: inherit;
        font-size: 9px;
        font-weight: 800;

        letter-spacing: 0.12em;

        cursor: pointer;
    }


    .admin-password-toggle:hover {
        color: var(--admin-gold);
    }


    /* =========================================================
       BOTÓN
       ========================================================= */

    .admin-login-submit {
        width: 100%;
        min-height: 56px;

        margin-top: 5px;
        padding: 0 21px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border: 1px solid var(--admin-navy);
        border-radius: 12px;

        background: var(--admin-navy);
        color: white;

        font-family: inherit;
        font-size: 11px;
        font-weight: 800;

        letter-spacing: 0.15em;

        cursor: pointer;

        transition:
            background 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }


    .admin-login-submit span {
        font-size: 19px;
        font-weight: 400;

        transition:
            transform 0.2s ease;
    }


    .admin-login-submit:hover {
        background: var(--admin-gold);
        border-color: var(--admin-gold);

        color: var(--admin-navy);
    }


    .admin-login-submit:hover span {
        transform: translateX(4px);
    }


    /* =========================================================
       VOLVER
       ========================================================= */

    .admin-login-back {
        display: inline-block;

        margin-top: 28px;

        color: var(--admin-muted);

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.08em;

        text-decoration: none;

        transition:
            color 0.2s ease;
    }


    .admin-login-back:hover {
        color: var(--admin-gold);
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 850px) {

        .admin-login-page {
            padding: 30px 18px;
        }

        .admin-login-shell {
            grid-template-columns: 1fr;
            min-height: auto;
        }

        .admin-login-brand {
            min-height: 270px;
            padding: 42px;
        }

        .admin-login-brand h2 {
            font-size: 44px;
        }

        .admin-login-description {
            margin-top: 18px;
        }

        .admin-login-form-panel {
            padding: 48px 42px;
        }

    }


    @@media (max-width: 520px) {

        .admin-login-page {
            padding: 18px 12px;
        }

        .admin-login-shell {
            border-radius: 22px;
        }

        .admin-login-brand {
            min-height: 230px;
            padding: 32px 28px;
        }

        .admin-login-logo {
            margin-bottom: 20px;
        }

        .admin-login-line {
            margin-bottom: 20px;
        }

        .admin-login-brand h2 {
            font-size: 38px;
        }

        .admin-login-description {
            font-size: 12px;
        }

        .admin-login-form-panel {
            padding: 40px 26px;
        }

        .admin-login-form-content h1 {
            font-size: 39px;
        }

        .admin-login-subtitle {
            margin-bottom: 28px;
        }

    }

</style>


<script>

    function toggleAdminPassword() {

        const password =
            document.getElementById(
                "password"
            );

        const icon =
            document.getElementById(
                "passwordIcon"
            );


        if (password.type === "password") {

            password.type = "text";

            icon.textContent =
                "OCULTAR";

        }
        else {

            password.type = "password";

            icon.textContent =
                "VER";

        }
    }

</script>
