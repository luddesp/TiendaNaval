@model List<TiendaNaval.Models.Producto>

@{
    ViewData["Title"] = "Buscar";
}

<section class="search-page">

    <div class="search-header"> 

        <p class="search-eyebrow">
            VYR — COLECCIÓN NAVAL
        </p>

        <h1>Buscar productos</h1>

    </div>


    <form asp-controller="Productos"
          asp-action="Buscar"
          method="get"
          class="product-search">

        <input type="text"
               name="q"
               value="@ViewBag.Busqueda"
               placeholder="¿Qué estás buscando?"
               autofocus />

        <button type="submit">
            buscar
        </button>

    </form>


    @if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
    {
        <p class="search-result-text">
            RESULTADOS PARA “@ViewBag.Busqueda”
        </p>
    }


    @if (Model.Any())
    {
        <div class="rhode-product-grid">

            @foreach (var producto in Model)
            {
                <article class="rhode-product-card">

                    <a asp-controller="Productos"
                       asp-action="Detalle"
                       asp-route-id="@producto.Id">

                        <div class="rhode-product-image">

                            @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                            {
                                <img src="@producto.ImagenUrl"
                                     alt="@producto.Nombre" />
                            }

                        </div>

                        <div class="rhode-product-info">

                            <h2>
                                @producto.Nombre
                            </h2>

                            <p>
                                $@producto.Precio.ToString("N0")
                            </p>

                        </div>

                    </a>

                </article>
            }

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
    {
        <div class="search-empty">

            <p>
                No encontramos productos con ese nombre.
            </p>

        </div>
    }

</section>
<style>
    .search-page {
        width: min(1400px, calc(100% - 80px));
        margin: 0 auto;
        padding: 70px 0 100px;
    }

    .search-header {
        margin-bottom: 45px;
    }

    .search-eyebrow {
        margin-bottom: 15px;

        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .search-header h1 {
        margin: 0;

        font-size: clamp(42px, 5vw, 72px);
        font-weight: 400;
        letter-spacing: -2px;
    }

    .product-search {
        display: flex;
        width: 100%;

        margin-bottom: 60px;

        border-bottom: 1px solid #1b1b1b;
    }

    .product-search input {
        flex: 1;

        padding: 20px 0;

        border: 0;
        outline: none;
        background: transparent;

        font-size: 22px;
    }

    .product-search button {
        padding: 0 25px;

        border: 0;
        background: transparent;

        font-size: 11px;
        letter-spacing: 2px;

        cursor: pointer;
    }

    .search-result-text {
        margin-bottom: 25px;

        font-size: 11px;
        letter-spacing: 1.5px;
    }

    .search-empty {
        padding: 70px 0;

        border-top: 1px solid #d5d2cc;

        text-align: center;
    }

    .search-empty p {
        font-size: 18px;
    }
</style>