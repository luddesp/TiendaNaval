@model IEnumerable<TiendaNaval.Models.Producto>

@{
    ViewData["Title"] = "Tienda";
}

<section class="shop-page">

    <!-- =========================
         ENCABEZADO
    ========================== -->
    <div class="shop-header">

        <div class="shop-header-main">
            <p class="shop-eyebrow">
                VYR / SHOP
            </p>

            <h1>
                Productos<span class="shop-title-star">✦</span>
            </h1>
        </div>

        <span class="shop-collection-number">
            01 / COLECCIÓN
        </span>

    </div>


    <!-- =========================
         PRODUCTOS
    ========================== -->
    <div class="shop-grid">

        @if (Model != null && Model.Any())
        {
            foreach (var producto in Model)
            {
                <article class="shop-card">

                    <!-- IMAGEN -->
                    <a asp-controller="Productos"
                       asp-action="Detalle"
                       asp-route-id="@producto.Id"
                       class="shop-card-image">

                        @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                        {
                            <img src="@producto.ImagenUrl"
                                 alt="@producto.Nombre" />
                        }
                        else
                        {
                            <div class="shop-no-image">
                                VYR
                            </div>
                        }

                    </a>


                    <!-- INFORMACIÓN -->
                    <div class="shop-card-info">

                        <div class="shop-product-main">

                            <h2>
                                @producto.Nombre
                            </h2>

                            @if (producto.Categoria != null)
                            {
                                <span class="shop-category">
                                    @producto.Categoria.Nombre
                                </span>
                            }

                        </div>

                        <span class="shop-price">
                            $@producto.Precio.ToString("N0")
                        </span>

                    </div>


                    <!-- BOTÓN -->
                    <div class="shop-card-footer">

                        <a asp-controller="Productos"
                           asp-action="Detalle"
                           asp-route-id="@producto.Id"
                           class="shop-view-button">

                            <span>VER PRODUCTO</span>
                            <span class="shop-arrow">→</span>

                        </a>

                    </div>

                </article>
            }
        }
        else
        {
            <div class="shop-empty">

                <span class="shop-empty-star">✦</span>

                <p>
                    Todavía no hay productos disponibles.
                </p>

            </div>
        }

    </div>

</section>