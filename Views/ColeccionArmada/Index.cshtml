@model IEnumerable<TiendaNaval.Models.Producto>

@{
    ViewData["Title"] = "Colección Armada";
}

<section class="armada-page">

    <!-- ========================================
         PORTADA COLECCIÓN
    ========================================= -->
    <div class="armada-header">

        <div class="armada-header-content">

            <p class="armada-eyebrow">
                VYR / COLECCIÓN ARMADA
            </p>

            <h1>
                Colección<br />
                Armada<span class="armada-title-star">✦</span>
            </h1>

            <p class="armada-description">
                Inspirada en la tradición naval.<br />
                Diseñada para quienes llevan la Armada con orgullo.
            </p>

        </div>


        <div class="armada-header-side">

            <span class="armada-collection-number">
                03 / ARMADA
            </span>

        </div>

    </div>


    <!-- ========================================
         PRODUCTOS
    ========================================= -->
    <div class="armada-products-header">

        <div>

            <p class="armada-eyebrow">
                COLECCIÓN
            </p>

            <h2>
                Productos Armada
            </h2>

        </div>

        <span class="armada-product-count">
            @Model.Count() PRODUCTOS
        </span>

    </div>


    <!-- ========================================
         GRILLA DE PRODUCTOS
    ========================================= -->
    <div class="armada-product-grid">

        @if (Model != null && Model.Any())
        {
            foreach (var producto in Model)
            {
                <article class="armada-product-card">

                    <!-- IMAGEN -->
                    <a asp-controller="Productos"
                       asp-action="Detalle"
                       asp-route-id="@producto.Id"
                       class="armada-product-image">

                        @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                        {
                            <img src="@producto.ImagenUrl"
                                 alt="@producto.Nombre" />
                        }
                        else
                        {
                            <div class="armada-no-image">
                                VYR
                            </div>
                        }

                    </a>


                    <!-- INFORMACIÓN -->
                    <div class="armada-product-info">

                        <div class="armada-product-main">

                            <p class="armada-product-category">
                                @(producto.Categoria?.Nombre ?? "COLECCIÓN ARMADA")
                            </p>

                            <h3>
                                @producto.Nombre
                            </h3>

                        </div>

                        <span class="armada-product-price">
                            $@producto.Precio.ToString("N0")
                        </span>

                    </div>


                    <!-- BOTÓN -->
                    <a asp-controller="Productos"
                       asp-action="Detalle"
                       asp-route-id="@producto.Id"
                       class="armada-product-button">

                        <span>
                            VER PRODUCTO
                        </span>

                        <span class="armada-product-arrow">
                            →
                        </span>

                    </a>

                </article>
            }
        }
        else
        {
            <div class="armada-empty">

                <span class="armada-empty-star">
                    ✦
                </span>

                <h2>
                    Próximamente.
                </h2>

                <p>
                    Estamos preparando la Colección Armada.
                </p>

            </div>
        }

    </div>

</section>