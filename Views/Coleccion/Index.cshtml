@model IEnumerable<TiendaNaval.Models.Producto>

@{
    ViewData["Title"] = "Colección ESSA";
}

<section class="essa-page">

    <!-- ========================================
         PORTADA COLECCIÓN
    ========================================= -->
    <div class="essa-header">

        <div class="essa-header-content">

            <p class="essa-eyebrow">
                VYR / COLECCIÓN ESSA
            </p>

            <h1>
                Colección<br />
                ESSA<span class="essa-title-star">✦</span>
            </h1>

            <p class="essa-description">
                Diseñada para aspirantes.<br />
                Inspirada en nuestra identidad.
            </p>

        </div>
    </div>


    <!-- ========================================
         PRODUCTOS
    ========================================= -->
    <div class="essa-products-header">

        <div>

            <p class="essa-eyebrow">
                COLECCIÓN
            </p>

            <h2>
                Productos ESSA
            </h2>

        </div>

        <span class="essa-product-count">
            @Model.Count() PRODUCTOS
        </span>

    </div>


    <!-- ========================================
         GRILLA
    ========================================= -->
    <div class="essa-product-grid">

        @if (Model != null && Model.Any())
        {
            foreach (var producto in Model)
            {
                <article class="essa-product-card">

                    <!-- IMAGEN -->
                    <a asp-controller="Productos"
                       asp-action="Detalle"
                       asp-route-id="@producto.Id"
                       class="essa-product-image">

                        @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                        {
                            <img src="@producto.ImagenUrl"
                                 alt="@producto.Nombre" />
                        }
                        else
                        {
                            <div class="essa-no-image">
                                VYR
                            </div>
                        }

                    </a>


                    <!-- INFORMACIÓN -->
                    <div class="essa-product-info">

                        <div class="essa-product-main">

                            <p class="essa-product-category">
                                @(producto.Categoria?.Nombre ?? "COLECCIÓN ESSA")
                            </p>

                            <h3>
                                @producto.Nombre
                            </h3>

                        </div>

                        <span class="essa-product-price">
                            $@producto.Precio.ToString("N0")
                        </span>

                    </div>


                    <!-- BOTÓN -->
                    <a asp-controller="Productos"
                       asp-action="Detalle"
                       asp-route-id="@producto.Id"
                       class="essa-product-button">

                        <span>
                            VER PRODUCTO
                        </span>

                        <span class="essa-product-arrow">
                            →
                        </span>

                    </a>

                </article>
            }
        }
        else
        {
            <div class="essa-empty">

                <span class="essa-empty-star">
                    ✦
                </span>

                <h2>
                    Próximamente.
                </h2>

                <p>
                    Estamos preparando los productos de la colección ESSA.
                </p>

            </div>
        }

    </div>

</section>
<style>
    /* =========================================
   MENOS ESPACIO ENTRE PORTADA Y PRODUCTOS
========================================= */

    .essa-header {
        padding-bottom: 25px;
        min-height: auto;
    }

    .essa-header-content {
        padding-bottom: 0;
    }

    .essa-description {
        margin-bottom: 0;
    }

    .essa-products-header {
        margin-top: 0;
        padding-top: 20px;
        margin-bottom: 22px;
    }

    .essa-product-grid {
        margin-top: 0;
    }
</style>
