<!-- =========================================
CARRITO LATERAL GLOBAL
========================================== -->

<div id="cartDrawerContainer"></div>


<!-- =========================================
JAVASCRIPT DEL CARRITO
========================================== -->

<script>

        // =========================================
        // ABRIR CARRITO
        // =========================================

        async function abrirCarrito() {

            try {

                const response = await fetch(
                    '@Url.Action("Drawer", "Carrito")'
                );


                if (!response.ok) {

                    console.error(
                        "No se pudo cargar el carrito."
                    );

                    return;
                }


                const html =
                    await response.text();


                const container =
                    document.getElementById(
                        "cartDrawerContainer"
                    );


                if (!container) {

                    console.error(
                        "No existe cartDrawerContainer."
                    );

                    return;
                }


                container.innerHTML = html;


                const drawer =
                    document.getElementById(
                        "cartDrawer"
                    );


                const overlay =
                    document.getElementById(
                        "cartOverlay"
                    );


                if (!drawer) {

                    console.error(
                        "No se encontró cartDrawer."
                    );

                    return;
                }


                requestAnimationFrame(() => {

                    drawer.classList.add(
                        "open"
                    );


                    if (overlay) {

                        overlay.classList.add(
                            "open"
                        );

                    }


                    document.body.classList.add(
                        "cart-is-open"
                    );

                });

            }
            catch (error) {

                console.error(
                    "Error al abrir carrito:",
                    error
                );

            }

        }


        // =========================================
        // CERRAR CARRITO
        // =========================================

        function cerrarCarrito() {

            const container =
                document.getElementById(
                    "cartDrawerContainer"
                );

            if (container) {
                container.innerHTML = "";
            }

            document.body.classList.remove(
                "cart-is-open"
            );

            document.body.style.overflow = "";
        }
        // =========================================
        // AGREGAR PRODUCTO
        // =========================================

        async function agregarAlCarrito(event, id) {

            event.preventDefault();


            const form =
                event.currentTarget;


            // Validaciones del formulario

            if (!form.checkValidity()) {

                form.reportValidity();

                return;
            }


            const datos =
                new FormData(form);


            datos.set(
                "id",
                id
            );


            try {

                const response = await fetch(
                    '@Url.Action("AgregarAjax", "Carrito")',
                    {
                        method: "POST",

                        body: datos
                    }
                );


                if (!response.ok) {

                    console.error(
                        "No se pudo agregar el producto."
                    );

                    return;
                }


                // PRIMERO ABRIMOS EL CARRITO

                await abrirCarrito();


                // DESPUÉS ACTUALIZAMOS EL CONTADOR

                await cargarCantidadCarrito();

            }
            catch (error) {

                console.error(
                    "Error al agregar al carrito:",
                    error
                );

            }

        }


        // =========================================
        // CAMBIAR CANTIDAD
        // =========================================

        async function cambiarCantidad(
            id,
            cantidad)
        {

            try {

                const datos =
                    new URLSearchParams();


                datos.append(
                    "id",
                    id
                );


                datos.append(
                    "cantidad",
                    cantidad
                );


                const response = await fetch(
                    '@Url.Action("ActualizarAjax", "Carrito")',
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded"
                        },

                        body:
                            datos.toString()
                    }
                );


                if (!response.ok) {

                    console.error(
                        "No se pudo actualizar la cantidad."
                    );

                    return;
                }


                await abrirCarrito();

                await cargarCantidadCarrito();

            }
            catch (error) {

                console.error(
                    "Error al actualizar carrito:",
                    error
                );

            }

        }


        // =========================================
        // ELIMINAR PRODUCTO
        // =========================================

        async function eliminarDelCarrito(id) {

            try {

                const datos =
                    new URLSearchParams();


                datos.append(
                    "id",
                    id
                );


                const response = await fetch(
                    '@Url.Action("QuitarAjax", "Carrito")',
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded"
                        },

                        body:
                            datos.toString()
                    }
                );


                if (!response.ok) {

                    console.error(
                        "No se pudo eliminar el producto."
                    );

                    return;
                }


                await abrirCarrito();

                await cargarCantidadCarrito();

            }
            catch (error) {

                console.error(
                    "Error al eliminar producto:",
                    error
                );

            }

        }


        // =========================================
        // ACTUALIZAR CONTADOR
        // =========================================

        function actualizarContador(cantidad) {

            const contador =
                document.getElementById(
                    "cartCount"
                );


            if (!contador) {

                return;

            }


            contador.textContent =
                cantidad ?? 0;

        }


        // =========================================
        // OBTENER CANTIDAD
        // =========================================

        async function cargarCantidadCarrito() {

            try {

                const response = await fetch(
                    '@Url.Action("Cantidad", "Carrito")'
                );


                if (!response.ok) {

                    return;

                }


                const resultado =
                    await response.json();


                actualizarContador(
                    resultado.cantidad
                );

            }
            catch (error) {

                console.error(
                    "No se pudo cargar el contador:",
                    error
                );

            }

        }


        // =========================================
        // AL CARGAR LA PÁGINA
        // =========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                cargarCantidadCarrito();

            }
        );


        // =========================================
        // ESC PARA CERRAR
        // =========================================

        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    cerrarCarrito();

                }

            }
        );

    </script>


@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>

